{
  "manifest_version": 3,
  "name": "OA Corp Sales：Evox 撥打按鈕",
  "version": "1.0",
  "description": "(corp-sales-dial-btn) 在銷售頁面的電話號碼旁自動注入 Evox 一鍵撥打按鈕",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://corp.orangeapple.co/marketing/sales*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}