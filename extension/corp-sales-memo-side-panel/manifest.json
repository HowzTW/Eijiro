{
  "manifest_version": 3,
  "name": "OA 體驗課程預約紀錄",
  "version": "1.0",
  "description": "體驗課程預約記錄側邊欄，支援場次ID自動查詢",
  "permissions": ["sidePanel"],
  "host_permissions": ["https://corp.orangeapple.co/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OA 體驗課程預約紀錄"
  },
  "content_scripts": [
    {
      "matches": ["https://corp.orangeapple.co/marketing/sales*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
