{
  "manifest_version": 3,
  "name": "OA Corp Sales：常見未接聽原因按鈕",
  "version": "1.0",
  "description": "在銷售頁面注入快捷按鈕，一鍵選填常見未接聽原因並記錄",
  "content_scripts": [
    {
      "matches": [
        "https://corp.orangeapple.co/marketing/sales*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}