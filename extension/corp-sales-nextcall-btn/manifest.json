{
  "manifest_version": 3,
  "name": "OrangeApple 銷售預約時間提醒",
  "version": "1.0",
  "description": "當銷售頁面的下一次撥打時間為空時，顯示 [預約時間] 提示文字",
  "content_scripts": [
    {
      "matches": ["https://corp.orangeapple.co/marketing/sales*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
