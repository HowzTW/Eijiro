{
  "manifest_version": 3,
  "name": "預約回撥排程",
  "version": "1.0",
  "description": "預約回撥排程提醒工具",
  "permissions": ["storage", "alarms", "tabs", "sidePanel", "windows", "notifications", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "預約回撥排程",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
