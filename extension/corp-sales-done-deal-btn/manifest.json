{
  "manifest_version": 3,
  "name": "OA Corp Sales：一鍵已報名按鈕",
  "version": "1.0",
  "description": "(corp-sales-done-deal-btn) 在銷售頁面每筆名單注入快捷按鈕，一鍵將名單設為已報名",
  "content_scripts": [
    {
      "matches": [
        "https://corp.orangeapple.co/marketing/sales*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
