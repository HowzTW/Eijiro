{
  "manifest_version": 3,
  "name": "OA Corp Sales：發現新名單通知",
  "version": "1.0",
  "description": "(corp-sales-new-student-alert) 偵測銷售頁面出現新潛在學生名單時，自動發出聲音與桌面通知",
  "permissions": [
    "notifications"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://corp.orangeapple.co/marketing/sales*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}